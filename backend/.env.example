PORT=5000
# Local Postgres (default). Create db: createdb finance_dashboard
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/finance_dashboard?schema=public"
# Or Neon/Supabase/Render free tier, e.g:
# DATABASE_URL="postgresql://user:password@ep-xxx.neon.tech/finance_dashboard?sslmode=require"
JWT_SECRET=supersecret_finance_key_change_this
JWT_EXPIRE=7d
CLIENT_URL=http://localhost:5173
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password
MAIL_FROM=FinanceDash <no-reply@example.com>
